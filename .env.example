# baike-storm 环境变量模板
# 复制为 .env 并按需填写;所有变量均可省略 —— 不配 LLM 时可用 `baike-storm demo` 跑离线演示。

# ═══ 必配:LLM(任意 OpenAI 兼容 chat/completions 服务)════════════════════
# 贵司网关 / OpenAI / DeepSeek / 本地 vLLM 均可
STORM_LLM_BASE_URL=https://api.example.com/v1
STORM_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
STORM_LLM_MODEL=gpt-4o-mini

# 兼容别名:若使用 pipeline 老的变量名(二选一即可,优先生效)
# _llm.pipeline_client() 读取的是 OPENAI_BASE_URL / OPENAI_API_KEY / RESEARCH_MODEL
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# RESEARCH_MODEL=gpt-4o-mini

# ═══ 检索后端(二选一)══════════════════════════════════════════════════════
# 1) 真实检索:Tavily(https://tavily.com 注册后获取 API Key)
STORM_SEARCH_BACKEND=tavily
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# 2) 离线 mock(读取包内 data/mock_corpus/*.json,供 demo / 单测)
# STORM_SEARCH_BACKEND=mock

# ═══ 评测 judge(score / eval 命令)════════════════════════════════════════
# 默认走 OpenAI 兼容端点;JUDGE_BACKEND=anthropic 时走 /v1/messages 协议
JUDGE_BACKEND=openai
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_API_KEY=sk-xxxxxxxxxxxxxxxx
JUDGE_MODEL=gpt-4o-mini
# entity_recall 的判等默认用 LLM;设 ENTITY_RECALL_LLM=0 退回词法
# ENTITY_RECALL_LLM=1

# ═══ 配图(VLM 版面规划,可选)══════════════════════════════════════════════
# FIG_VLM_BASE_URL=http://vlm-gateway.example.com/v1
# FIG_VLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# FIG_VLM_MODEL=your-vlm-model
# FIG_PROXY=http://127.0.0.1:8899

# ═══ 可选开关与路径 ═══════════════════════════════════════════════════════
# STORM_RUNS_DIR=./runs                  # 生成产物输出目录
# STORM_GOLD_DIR=./data/gold            # 评测参考答案目录(gold/<title>.json)
# STORM_EDITORIAL_GUIDELINES=./data/editorial_guidelines.example.md
# STORM_FIG_PLAN=1                      # 成文后做版面规划(0 = 规则排版)
# STORM_NEWS=1                          # 启用「最新动态」视角
# STORM_TODAY=2026-01-01                # 固定运行日(复现实验)
# STORM_WEB_HOST=127.0.0.1
# STORM_WEB_PORT=8765

# ═══ LangSmith 轨迹(可选)══════════════════════════════════════════════════
# LANGCHAIN_API_KEY=lsv2-xxxxxxxxxxxxxxxx
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=baike-storm